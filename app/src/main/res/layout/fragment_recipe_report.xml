<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/recipe_editor_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/form_scroll_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Actual staging area for the contents-->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Report title -->
            <TextView
                android:id="@+id/report_title_text_view"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Recipe Report"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginTop="24dp"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <!-- Date time generated -->
            <TextView
                android:id="@+id/date_time_text_view"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                tools:text="Generated: Oct 4, 2026 10:34 AM"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginTop="8dp"
                android:textSize="16sp"
                android:textStyle="normal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/report_title_text_view"/>

            <!-- Total recipes -->
            <TextView
                android:id="@+id/total_recipes_text_view"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                tools:text="Total Recipes: 4"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginTop="36dp"
                android:textSize="16sp"
                android:textStyle="normal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/date_time_text_view"/>

            <!-- Beginning of Columns -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/report_header"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginTop="24dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/total_recipes_text_view">


            <!-- Recipe Column -->
                <TextView
                    android:id="@+id/recipe_column"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Recipe"
                    android:textStyle="bold"
                    android:gravity="start"
                    app:layout_constraintHorizontal_weight="2.5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/ingredient_column"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Ingredient Column -->
                <TextView
                    android:id="@+id/ingredient_column"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Ingredients"
                    android:textStyle="bold"
                    android:gravity="center"
                    app:layout_constraintHorizontal_weight="1"
                    app:layout_constraintStart_toEndOf="@id/recipe_column"
                    app:layout_constraintEnd_toStartOf="@id/instruction_column"
                    app:layout_constraintTop_toTopOf="@id/recipe_column" />

                <!-- Instruction Column -->
                <TextView
                    android:id="@+id/instruction_column"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Instructions"
                    android:textStyle="bold"
                    android:gravity="center"
                    app:layout_constraintHorizontal_weight="1"
                    app:layout_constraintStart_toEndOf="@id/ingredient_column"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/recipe_column" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginTop="6dp"
                    android:background="?android:attr/listDivider"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/recipe_column" />

            </androidx.constraintlayout.widget.ConstraintLayout>



            <!-- Recipe Report RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recipe_report_recycler_view"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginTop="4dp"
                app:layout_constraintTop_toBottomOf="@id/report_header"
                android:nestedScrollingEnabled="false"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
