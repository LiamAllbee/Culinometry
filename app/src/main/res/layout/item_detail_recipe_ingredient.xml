<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_constraintEnd_toEndOf="parent"
    android:paddingBottom="8dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Ingredient number -->
    <TextView
        android:id="@+id/ingredient_number_text_view"
        android:layout_width="28dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textSize="16sp"
        tools:text="1."
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Ingredient name -->
    <TextView
        android:id="@+id/ingredient_name_text_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:text="Testing"
        app:layout_constraintStart_toEndOf="@id/ingredient_number_text_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Quantity text -->
    <TextView
        android:id="@+id/ingredient_quantity_text_view"
        android:layout_width="80dp"
        android:layout_height="36dp"
        android:layout_marginTop="4dp"
        android:layout_marginStart="12dp"
        android:gravity="end|center_vertical"
        android:textSize="15sp"
        tools:text="33333"
        app:layout_constraintStart_toEndOf="@id/ingredient_number_text_view"
        app:layout_constraintTop_toBottomOf="@id/ingredient_name_text_view" />

    <!-- Unit button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/unit_button"
        style="?attr/materialButtonTonalStyle"
        android:layout_width="72dp"
        android:layout_height="36dp"
        android:layout_marginStart="16dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:paddingStart="10dp"
        android:paddingEnd="6dp"
        android:textSize="13sp"
        android:textAllCaps="false"
        android:gravity="center"
        app:icon="@drawable/arrow_drop_down_24px"
        app:iconGravity="textEnd"
        app:iconPadding="2dp"
        tools:text="tbsp"
        app:layout_constraintStart_toEndOf="@id/ingredient_quantity_text_view"
        app:layout_constraintTop_toTopOf="@id/ingredient_quantity_text_view"
        app:layout_constraintBottom_toBottomOf="@id/ingredient_quantity_text_view" />

</androidx.constraintlayout.widget.ConstraintLayout>