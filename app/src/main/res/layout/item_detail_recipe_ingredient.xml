<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_constraintEnd_toEndOf="parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <TextView
        android:id="@+id/ingredient_number_text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:textSize="16sp"
        android:text=""
        tools:text="1. "
        android:paddingEnd="8dp"
        android:paddingVertical="4dp"/>

    <TextView
        android:id="@+id/ingredient_detail_text_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/ingredient_number_text_view"
        app:layout_constraintEnd_toEndOf="parent"
        android:textSize="16sp"
        android:text=""
        tools:text="1 1/3 Cup Low Fat Greek Yogurt1 1/3 Cup Low Fat Greek Yogurt1 1/3 Cup Low Fat Greek Yogurt"
        android:paddingVertical="4dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>